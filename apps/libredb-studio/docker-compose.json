{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "libredb-studio",
      "image": "libredb/libredb-studio:0.18.2",
      "internalPort": 3000,
      "isMain": true,
      "environment": [
        {
          "key": "ADMIN_PASSWORD",
          "value": "${LIBREDB_STUDIO_ADMIN_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data"
        }
      ]
    }
  ],
  "schemaVersion": 2
}
